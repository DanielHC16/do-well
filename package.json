{
  "name": "do-well",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.9",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier --write app scripts src tests app.config.ts eas.json expo-env.d.ts eslint.config.js jest.config.js package.json tsconfig.json",
    "format:check": "prettier --check app scripts src tests app.config.ts eas.json expo-env.d.ts eslint.config.js jest.config.js package.json tsconfig.json",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:run": "jest --runInBand",
    "test:auth:integration": "jest --config jest.integration.config.js --runInBand",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --schema public --level warning --fail-on warning",
    "db:test": "supabase test db --local supabase/tests/010_schema_contract.test.sql supabase/tests/020_profile_provisioning.test.sql supabase/tests/030_rls_and_grants.test.sql supabase/tests/040_storage_policies.test.sql supabase/tests/050_relationship_constraints.test.sql supabase/tests/060_auth_profile_rpcs.test.sql supabase/tests/070_gig_management_rpcs.test.sql supabase/tests/080_gig_discovery_rpcs.test.sql supabase/tests/090_application_and_selection_rpcs.test.sql supabase/tests/100_assignment_and_milestone_rpcs.test.sql supabase/tests/110_submission_and_approval_rpcs.test.sql supabase/tests/120_evidence_submission_rpcs.test.sql supabase/tests/130_admin_roles_reporting.test.sql",
    "db:test:performance": "supabase test db --local supabase/tests/performance/010_query_plans.test.sql",
    "db:types": "node scripts/database-types.mjs",
    "db:types:check": "node scripts/database-types.mjs --check"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.2",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "typescript": "~6.0.3"
  }
}
