{
  "expo": {
    "name": "Do Well",
    "slug": "do-well",
    "version": "0.1.0",
    "scheme": "dowell",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.anghulingpullrequest.dowell",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
